    "license": "MIT",
    "description": "Bruno is a Git-integrated, fully offline, and open-source API client",
    "architecture": {
        "64bit": {
            "url": "https://github.com/usebruno/bruno/releases/download/v4.4.0/bruno_4.4.0_x64_win.zip",
            "hash": "6a81d51c8fe9f3d2bbb63febff95d93871b48b2340d0f73c65f162522a522821"
        }
    },
    "installer": {
        "script": [
            ". \"$bucketsdir\\doge\\scripts\\utils.ps1\"",
            "Set-Junction -Source \"$persist_dir\\AppData\" -Target \"$env:APPDATA\\bruno\""
        ]
    },
    "uninstaller": {
        "script": [
            ". \"$bucketsdir\\doge\\scripts\\utils.ps1\"",
            "Remove-Junction -Path \"$env:APPDATA\\bruno\""
        ]
    },
    "persist": "collections",
    "shortcuts": [
        [
            "Bruno.exe",
            "Bruno"
        ]
    ],
    "checkver": {
        "github": "https://github.com/usebruno/bruno"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/usebruno/bruno/releases/download/v$version/bruno_$version_x64_win.zip"
            }
        }
    }
}
